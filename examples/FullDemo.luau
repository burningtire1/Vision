local BASE = "https://raw.githubusercontent.com/OWNER/REPO/main/"
local Library = loadstring(game:HttpGet(BASE.."init.luau"))(BASE)
-- Paste after loading Library, or use the generated Demo.luau directly.
local env = type(getgenv)=="function" and getgenv() or _G
local previousVision, previousLapse = env.VisionDemo, env.LapseDemo
if previousVision then previousVision:Destroy() end
if previousLapse and previousLapse~=previousVision then previousLapse:Destroy() end
local window = Library.new({Title="Vision",Size=Vector2.new(650,452),Position=UDim2.fromOffset(100,150),Footer="Welcome back, "..game:GetService("Players").LocalPlayer.DisplayName.."!"})
env.LapseDemo=window
env.VisionDemo=window
local combat=window:CreateTab({Name="Combat",Icon="swords"})
local movement=window:CreateTab({Name="Movement",Icon="wind"})
local visuals=window:CreateTab({Name="Visuals",Icon="eye"})
local settings=window:CreateTab({Name="Settings",Icon="settings"})
local weapon=combat:CreateSection({Name="Weapon",Column=1})
weapon:AddToggle({Name="No Recoil",Id="noRecoil"})
weapon:AddToggle({Name="Fast Reload",Id="fastReload",Default=true})
weapon:AddToggle({Name="Infinite Ammo",Id="infiniteAmmo",Style="Checkbox"})
weapon:AddSlider({Name="Fire Rate",Id="fireRate",Min=0,Max=1000,Default=475,Suffix=" RPM"})
weapon:AddSlider({Name="Recoil Modifier",Id="recoilModifier",Default=25,Suffix="%"})
weapon:AddDropdown({Name="Fire Mode",Id="fireMode",Options={"Semi Automatic","Automatic","Burst"},Default="Semi Automatic"})
local states=combat:CreateSection({Name="Element States",Column=2})
states:AddToggle({Name="Disabled Toggle",Id="disabledToggle",Default=true,Disabled=true})
states:AddSlider({Name="Disabled Slider",Id="disabledSlider",Default=65,Suffix="%",Disabled=true})
states:AddDropdown({Name="Disabled Dropdown",Id="disabledDropdown",Options={"Option 1","Option 2","Option 3"},Default="Option 2",Disabled=true})
local targeting=combat:CreateSection({Name="Targeting",Column=2,Icon="crosshair"})
targeting:AddToggle({Name="Target Highlight",Id="targetHighlight"})
targeting:AddSlider({Name="Maximum Distance",Id="targetDistance",Min=0,Max=1000,Default=300,Suffix=" studs"})
targeting:AddDropdown({Name="Priority",Id="priority",Options={"Health","Distance","Closest to cursor"}})
local aim=combat:CreateSection({Name="Aimbot",Column=1,Icon="crosshair"})
local enabled=aim:AddToggle({Name="Enabled",Id="aimEnabled",Default=true})
enabled:Bind({Name="Enabled",Id="aimBind",Default="B"})
aim:AddToggle({Name="Silent Targeting",Id="silentTargeting",Style="Checkbox"})
aim:AddToggle({Name="Prediction",Id="prediction"})
aim:AddToggle({Name="Wall Check",Id="wallCheck",Style="Checkbox"})
aim:AddToggle({Name="Team Check",Id="teamCheck",Style="Checkbox"})
aim:AddSlider({Name="Field of View",Id="fov",Min=0,Max=500,Default=500,Suffix="°"})
aim:AddSlider({Name="Smoothness",Id="smoothness",Min=0,Max=1,Step=0.01,Default=0.75})
aim:AddDropdown({Name="Target Part",Id="targetPart",Options={"HumanoidRootPart","Head","UpperTorso"}})
aim:AddDropdown({Name="Checks",Id="checks",Multi=true,Options={"Alive","Visible","Team","Distance"},Default={"Alive","Visible"}})
aim:Detach(Vector2.new(790,242))
local regular=movement:CreateSection({Name="Targeting (regular)",Icon="crosshair",Column=1})
regular:AddToggle({Name="Checkbox",Id="checkbox1",Style="Checkbox"})
regular:AddToggle({Name="Checkbox",Id="checkbox2",Style="Checkbox",Default=true})
regular:AddToggle({Name="Enabled",Id="move1"})
regular:AddToggle({Name="Enabled",Id="move2",Default=true})
regular:AddKeybind({Name="Test Hold Key",Id="holdKey",Default="V",Mode="Hold"})
regular:AddColorpicker({Name="Toggle Tint",Id="tint",Default=Color3.fromRGB(86,127,214)})
regular:AddColorpicker({Name="Colorpicker",Id="accentPicker",Default=Color3.fromRGB(145,120,255),Callback=function(color) window:SetTheme({Accent=color}) end})
local hovered=movement:CreateSection({Name="Targeting (hovered)",Icon="crosshair",Column=2})
hovered:AddButton({Name="Button",Callback=function() window:Notify({Text="Button clicked"}) end})
hovered:AddButton({Name="Purple Button",Primary=true,Callback=function() window:Notify({Text="Nice and simple"}) end})
hovered:AddButtons({{Name="One"},{Name="Two"},{Name="Three"}})
hovered:AddDropdown({Name="Dropdown",Id="demoDropdown",Options={"Option 1","Option 2","Option 3","Option 4","Option 5","Option 6"},Default="Option 2"})
hovered:AddDropdown({Name="Multi Dropdown",Id="multiDropdown",Multi=true,Options={"Option 1","Option 2","Option 3","Option 4","Option 5","Option 6"},Default={"Option 2","Option 6"}})
local esp=visuals:CreateSection({Name="ESP",Icon="eye",Column=1})
esp:AddToggle({Name="Enabled",Id="espEnabled"})
esp:AddToggle({Name="Boxes",Id="espBoxes",Style="Checkbox"})
esp:AddToggle({Name="Names",Id="espNames",Style="Checkbox"})
esp:AddToggle({Name="Distance",Id="espDistance",Style="Checkbox"})
esp:AddSlider({Name="Maximum Distance",Id="espMax",Min=0,Max=5000,Default=2400,Suffix=" studs"})
local lighting=visuals:CreateSection({Name="Lighting",Icon="sun",Column=2})
lighting:AddSlider({Name="Brightness",Id="brightness",Min=0,Max=10,Default=2})
lighting:AddDropdown({Name="Lighting Preset",Id="lighting",Options={"Default","Daylight","Night"}})
local theme=settings:CreateSection({Name="Appearance",Icon="palette",Column=1})
theme:AddDropdown({Name="Theme",Id="theme",Options={"Vision","Midnight","Rose"},Aliases={Lapse="Vision"},Callback=function(value) window:SetTheme(value) end})
theme:AddDropdown({Name="Layout",Id="layout",Options={"Auto","Desktop","Compact","Mobile"},Callback=function(value) window:SetLayout(value) end})
theme:AddToggle({Name="Keybind HUD",Id="showHUD",Default=true,Callback=function(value) window.HUD.Visible=value end})
theme:AddColorpicker({Name="Accent",Id="settingsAccent",Default=window.Theme.Accent,Callback=function(value) window:SetTheme({Accent=value}) end})
local configs=settings:CreateSection({Name="Configuration",Icon="save",Column=2})
configs:AddLabel("Default profile")
configs:AddButtons({{Name="Save",Primary=true,Callback=function() local ok,err=pcall(function() window:SaveConfig("Default") end); window:Notify({Text=ok and "Config saved" or tostring(err)}) end},{Name="Load",Callback=function() local ok,err=pcall(function() window:LoadConfig("Default",false) end); window:Notify({Text=ok and "Config loaded" or tostring(err)}) end}})
configs:AddButton({Name="Test notification",Callback=function() window:Notify({Text="Click to close",Duration=5}) end})
configs:AddLabel("RightShift to hide or show")
configs:AddLabel("Ctrl F to search")
combat:Select()
local text=movement:CreateSection({Name="Text & Information",Icon="text-cursor-input",Column=1})
text:AddTextbox({Name="Profile Name",Id="profileName",Default="My profile",Placeholder="Type a profile name",MaxLength=64})
text:AddTextbox({Name="Notes",Id="notes",Placeholder="Write a note",MultiLine=true,MaxLength=1000})
window.DemoParagraph=text:AddParagraph({Title="About Vision",Text="Vision is a UI library. Drag section headers to detach them or drop them back into the window. Inputs, sliders and color pickers also work with touch. Keybinds require a keyboard."})
local icons=movement:CreateSection({Name="Icon Gallery",Icon="layout-grid",Column=2})
icons:AddParagraph({Title="More Lucide icons",Text="49 icons are bundled locally. These include movement, input, paragraph, touch, menu, information, shield and panel icons."})
for _,name in ipairs({"shield","touchpad","file-text","panel-top","info","hand"}) do local label=icons:AddLabel("      "..name); window:_icon(label,name,UDim2.fromOffset(1,4),16,"Accent") end
env.LapseLibrary=Library
env.VisionLibrary=Library
window:CreateConfigManager({Id="settings",Autosave=false})
window:Notify({Title="Vision",Text="UI ready",Duration=3})
